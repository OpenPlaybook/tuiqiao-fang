{
  "name": "tuiqiao-fang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "第六堂课《用 AI 推敲字词》闯关网站：自适应题库 + DeepSeek 评委 + 教师后台",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check:gloss": "node scripts/check-gloss.mjs",
    "check:content": "node scripts/check-content.mjs",
    "build": "pnpm check:gloss && pnpm check:content && pnpm typecheck && node scripts/build-platform.mjs",
    "start": "node dist-server/server.cjs",
    "answers": "node dist-server/answers.js",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12",
    "esbuild": "^0.25.12",
    "@tailwindcss/postcss": "^4.1.13",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.11.1"
}
