{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./sdk/types/*"
      ],
      "@openplaybook/json-store": [
        "./sdk/types/packages/json-store/src/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "server",
    "common",
    "api.ts",
    "host.ts"
  ]
}
